{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "danielsundermeier/laravel-model-path": "^0.4.1",
        "guzzlehttp/guzzle": "^7.0.1",
        "laravel/framework": "^13.0",
        "laravel/sanctum": "^4.3",
        "laravel/telescope": "^5.20",
        "laravel/tinker": "^3.0",
        "spatie/laravel-cookie-consent": "^3.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.2",
        "danielsundermeier/laravel-make": "^0.4.0",
        "spatie/laravel-ignition": "^2.12",
        "fakerphp/faker": "^1.9.1",
        "laravel/breeze": "^2.4",
        "laravel/sail": "^1.60",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "v8.x-dev",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
